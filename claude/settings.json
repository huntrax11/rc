{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "MAX_THINKING_TOKENS": "128000"
  },
  "permissions": {
    "deny": [
      "Read(**/.env{,.local,.dev,.prod})",
      "Read(**/.dev.vars*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/config/database.yml)",
      "Read(**/config/credentials.json)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Edit(**/.env{,.local,.dev,.prod})",
      "Edit(**/secrets/**)",
      "Edit(**/.ssh/**)",
      "Bash(*git*push*--force*)",
      "Bash(*git*push*-f*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-terraform-destroy.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sed -n '/^## Commits$/,/^## [^#]/p' ~/.claude/CLAUDE.md | sed '$d' | jq -Rs '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":(\"COMMIT RULES (from CLAUDE.md):\\n\\n\" + .)}}'",
            "if": "Bash(*git*commit*)",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "effortLevel": "xhigh",
  "tui": "default",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
